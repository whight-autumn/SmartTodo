{
  "name": "smarttodo",
  "version": "1.3.1",
  "description": "SmartTodo · 本地优先任务与 AI 助手",
  "main": "main.js",
  "author": "萤火",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "electron tests/ui-smoke.cjs && electron tests/ui-layout.cjs && electron tests/ui-widget.cjs",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.smarttodo.app",
    "productName": "SmartTodo",
    "compression": "normal",
    "files": [
      "main.js",
      "main-paths.js",
      "task-attachment-store.js",
      "task-attachment-ipc.js",
      "preload.js",
      "widget-controller.js",
      "widget-window-state.js",
      "widget-ipc.js",
      "widget-preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SmartTodo-${version}.exe",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "SmartTodo-${version}.exe"
    }
  },
  "devDependencies": {
    "@fontsource/noto-serif-sc": "^5.3.0",
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
