{
  "name": "smart-assistant",
  "version": "1.0.5",
  "description": "智能任务管家 · AI 助手 - 桌面版",
  "main": "main.js",
  "author": "Smart Assistant",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "electron tests/ui-smoke.cjs",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.smart.assistant",
    "productName": "智能任务管家",
    "compression": "normal",
    "files": [
      "main.js",
      "main-paths.js",
      "task-attachment-store.js",
      "task-attachment-ipc.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}.exe",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "${productName}-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  }
}
